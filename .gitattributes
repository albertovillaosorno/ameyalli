# Text normalization: the authored content of this repository is Markdown
# and stays LF.
* text=auto eol=lf

# Figure assets are stored verbatim, with no end-of-line normalization.
*.png binary

*.yaml text eol=lf
*.md text eol=lf linguist-language=Markdown linguist-detectable -linguist-documentation
*.mdc text eol=lf linguist-language=Markdown linguist-detectable -linguist-documentation
*.tex text eol=lf
