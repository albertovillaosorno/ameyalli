+++ b/src/repository-runtime/integrations/git/commit-msg
@@ -0,0 +1,74 @@
+#!/bin/sh
+# Jig repository-local commit-message hook. Generated from Jig source.
+set -eu
+
+if [ "$#" -ne 1 ]; then
+    echo "jig: commit hook requires one message file" >&2
+    exit 1
+fi
+
+root=$(pwd -P)
+if [ ! -f "$root/.jig/jig.toml" ]; then
+    echo "jig: commit hook must run from the repository root" >&2
+    exit 1
+fi
+
+launcher="$root/.dependencies/jig/bin/jig"
+if [ -f "$launcher" ]; then
+    exec /bin/sh "$launcher" commit-message \
+        --root "$root" --file "$1"
+fi
+
+release_marker="$root/.dependencies/jig/release-v1.txt"
+if [ -f "$release_marker" ]; then
+    release_version=""
+    release_line=0
+    while IFS= read -r line || [ -n "$line" ]; do
+        release_line=$((release_line + 1))
+        case "$release_line:$line" in
+            "1:format=1") ;;
+            2:version=*) release_version=${line#version=} ;;
+            *)
+                echo "jig: active release marker is invalid" >&2
+                exit 1
+                ;;
+        esac
+    done < "$release_marker"
+    if [ "$release_line" -ne 2 ] || [ -z "$release_version" ]; then
+        echo "jig: active release marker is incomplete" >&2
+        exit 1
+    fi
+    case "$release_version" in
+        *[!0-9.-]*)
+            echo "jig: active release version is invalid" >&2
+            exit 1
+            ;;
+    esac
+    release="$root/.dependencies/jig/$release_version/bin/jig"
+    if [ ! -x "$release" ]; then
+        echo "jig: active release executable is unavailable" >&2
+        exit 1
+    fi
+    exec "$release" commit-message --root "$root" --file "$1"
+fi
+
+if [ ! -f "$root/Cargo.toml" ]; then
+    echo "jig: repository-local Jig launcher is unavailable" >&2
+    exit 1
+fi
+cargo=""
+for candidate in \
+    "$root"/.dependencies/rust/stable-*/bin/cargo.exe \
+    "$root"/.dependencies/rust/stable-*/bin/cargo
+do
+    if [ -x "$candidate" ]; then
+        cargo="$candidate"
+        break
+    fi
+done
+if [ -z "$cargo" ]; then
+    echo "jig: repository-local stable Cargo is unavailable" >&2
+    exit 1
+fi
+exec "$cargo" run --quiet --manifest-path \
+    "$root/tools/commit_hook/Cargo.toml" -- "$1"
